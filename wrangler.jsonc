{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "compatibility_date": "2026-08-15",
  "main": ".worker/index.js",
  "build": {
    "command": "hugo build --gc --minify && npx wrangler pages functions build --outdir .worker --build-output-directory public"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/builds/*"]
  },
  "observability": {
    "enabled": true
  }
}
